{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Detection Scenario Platform",
  "description": "Documentation for Detection Scenario Platform (DSP) — realistic security activity generation, evidence collection, and XDR/NDR customer POC validation.",
  "colors": {
    "primary": "#16A34A"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://dsp.xdr.ooo"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/xdr-labs/xdr-poc-script"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "/quickstart"
    }
  },
  "search": {
    "prompt": "Search DSP documentation..."
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://dsp.xdr.ooo"
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "groups": [
          {
            "group": "Start Here",
            "icon": "rocket",
            "pages": ["index", "quickstart"]
          },
          {
            "group": "POC Guide",
            "icon": "shield-check",
            "pages": ["poc-program", "scenarios", "third-party-alert-case-demo", "reports-and-evidence"]
          },
          {
            "group": "Setup & Operation",
            "icon": "terminal",
            "pages": ["installation", "configuration", "execution-modes", "safety-and-guardrails", "troubleshooting"]
          },
          {
            "group": "Reference",
            "icon": "book",
            "pages": ["cli-reference", "validation-status", "architecture", "release-notes"]
          }
        ]
      },
      {
        "language": "ko",
        "groups": [
          {
            "group": "시작하기",
            "icon": "rocket",
            "pages": ["ko/index", "ko/quickstart"]
          },
          {
            "group": "POC 가이드",
            "icon": "shield-check",
            "pages": ["ko/poc-program", "ko/scenarios", "ko/third-party-alert-case-demo", "ko/reports-and-evidence"]
          },
          {
            "group": "설치 및 운영",
            "icon": "terminal",
            "pages": ["ko/installation", "ko/configuration", "ko/execution-modes", "ko/safety-and-guardrails", "ko/troubleshooting"]
          },
          {
            "group": "참조",
            "icon": "book",
            "pages": ["ko/cli-reference", "ko/validation-status", "ko/architecture", "ko/release-notes"]
          }
        ]
      }
    ]
  }
}
