{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Detection Scenario Platform",
  "description": "Documentation for Detection Scenario Platform (DSP) — realistic security traffic generation, evidence collection, and XDR/NDR POC validation.",
  "colors": {
    "primary": "#16A34A"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://dsp.xdr.ooo"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/xdr-labs/xdr-poc-script"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Quick Start",
      "href": "/quickstart"
    }
  },
  "search": {
    "prompt": "Search DSP documentation..."
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://dsp.xdr.ooo"
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "groups": [
          {
            "group": "Overview",
            "icon": "radar",
            "pages": ["index", "quickstart", "poc-program"]
          },
          {
            "group": "Using DSP",
            "icon": "terminal",
            "pages": ["installation", "configuration", "execution-modes", "scenarios", "cli-reference"]
          },
          {
            "group": "POC & Evidence",
            "icon": "shield-check",
            "pages": ["third-party-alert-case-demo", "reports-and-evidence", "validation-status"]
          },
          {
            "group": "Operations",
            "icon": "gears",
            "pages": ["safety-and-guardrails", "troubleshooting", "architecture", "release-notes"]
          }
        ]
      },
      {
        "language": "ko",
        "groups": [
          {
            "group": "개요",
            "icon": "radar",
            "pages": ["ko/index", "ko/quickstart", "ko/poc-program"]
          },
          {
            "group": "DSP 사용",
            "icon": "terminal",
            "pages": ["ko/installation", "ko/configuration", "ko/execution-modes", "ko/scenarios", "ko/cli-reference"]
          },
          {
            "group": "POC 및 Evidence",
            "icon": "shield-check",
            "pages": ["ko/third-party-alert-case-demo", "ko/reports-and-evidence", "ko/validation-status"]
          },
          {
            "group": "운영",
            "icon": "gears",
            "pages": ["ko/safety-and-guardrails", "ko/troubleshooting", "ko/architecture", "ko/release-notes"]
          }
        ]
      }
    ]
  }
}
